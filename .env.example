# ── Server ───────────────────────────────────────────────────────────────────
PORT=6000

# ── SSO handoff from the hostmargin Portal ──────────────────────────────────
# Must match EXPOSE127_SSO_SECRET / constants.expose127.sso_secret in the
# hostmargin Portal app (C:\laragon\www\hostmargin) — HMAC-signs the one-time
# handoff token AND the local session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SSO_SECRET=

# Where to send visitors who need to log in (the Portal's SSO entry point)
PORTAL_LOGIN_URL=https://hostmargin.com/en-in/sso

# ── Shared data store ────────────────────────────────────────────────────────
# Must point at the SAME file the tunnel-server (hostmargin-full/server) writes
# to — see DB_PATH in hostmargin-full/server/.env.example. Both apps run on the
# same box, so this is just a shared local path.
DB_PATH=/var/www/vhosts/hmrg.xyz/httpdocs/tunnel-server/data/expose127.db
